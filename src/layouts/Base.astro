
---
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/playfair-display/800.css';
import '../styles/main.scss';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/images/hero-goochelaaarsem.jpg', Astro.site);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'EntertainmentBusiness',
  name: 'Sem Houtenbos',
  description: 'Goochelaar, entertainer en ballonkunstenaar voor evenementen, feesten en partijen.',
  url: Astro.site?.toString(),
  telephone: '+31622471896',
  email: 'info@semhoutenbos.nl',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'P.C. Boutensstraat 128',
    postalCode: '1822 KK',
    addressLocality: 'Alkmaar',
    addressCountry: 'NL',
  },
  sameAs: [
    'https://www.instagram.com/goochelaar_sem/',
    'https://www.facebook.com/profile.php?id=100078664136443',
  ],
};
---
<html lang="nl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="google-site-verification" content="UtWwXdIB4YkyZyYlYvcxYcVS2EIpz-B2i39VpbZFXcM" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:locale" content="nl_NL" />
<meta property="og:site_name" content="Sem Houtenbos" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script define:vars={{ GA_ID: 'G-ZJDZWF5SWT' }}>
  function loadGA() {
    if (window.gaLoaded) return;
    window.gaLoaded = true;
    const s = document.createElement('script');
    s.async = true;
    s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
    document.head.appendChild(s);
    window.dataLayer = window.dataLayer || [];
    function gtag(){ window.dataLayer.push(arguments); }
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', GA_ID);
  }
  if (localStorage.getItem('cookie-consent') === 'accepted') loadGA();
  document.addEventListener('cookie-consent-accepted', loadGA);
</script>
</head>
<body>
<noscript><style>[data-reveal],[data-reveal-onload]{opacity:1!important;transform:none!important;animation:none!important}</style></noscript>
<slot />
<CookieBanner />

<div class="form-modal-overlay" id="form-modal-overlay" style="display: none;">
  <div class="form-modal" role="status">
    <button type="button" class="form-modal__close" id="form-modal-close" aria-label="Sluiten">&times;</button>
    <p>Bedankt voor je bericht, ik neem zo snel mogelijk contact met je op.</p>
  </div>
</div>
<script>
  if (new URLSearchParams(window.location.search).get('verzonden')) {
    const overlay = document.getElementById('form-modal-overlay');
    if (overlay) overlay.style.display = 'flex';
    document.getElementById('form-modal-close')?.addEventListener('click', () => {
      if (overlay) overlay.style.display = 'none';
    });
    setTimeout(() => {
      window.location.href = '/';
    }, 3500);
  }
</script>
</body>
</html>
