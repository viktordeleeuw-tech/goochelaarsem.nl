
---
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/playfair-display/800.css';
import '../styles/main.scss';
import CookieBanner from '../components/CookieBanner.astro';

// GTM laadt alleen als PUBLIC_GTM_ID is gezet (Vercel env, Production). Zonder ID wordt er niets gemeten.
const gtmId = import.meta.env.PUBLIC_GTM_ID;

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/images/hero-goochelaaarsem.jpg', Astro.site);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'EntertainmentBusiness',
  name: 'Sem Houtenbos',
  description: 'Goochelaar, entertainer en ballonkunstenaar voor evenementen, feesten en partijen.',
  url: Astro.site?.toString(),
  telephone: '+31622471896',
  email: 'info@semhoutenbos.nl',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'P.C. Boutensstraat 128',
    postalCode: '1822 KK',
    addressLocality: 'Alkmaar',
    addressCountry: 'NL',
  },
  sameAs: [
    'https://www.instagram.com/goochelaar_sem/',
    'https://www.facebook.com/profile.php?id=100078664136443',
  ],
};
---
<html lang="nl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="google-site-verification" content="UtWwXdIB4YkyZyYlYvcxYcVS2EIpz-B2i39VpbZFXcM" />

<link rel="icon" href="/images/favicon/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png" />
<link rel="manifest" href="/images/favicon/site.webmanifest" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:locale" content="nl_NL" />
<meta property="og:site_name" content="Sem Houtenbos" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script is:inline>
  // Consent Mode v2: standaard geweigerd; opgeslagen keuze (sh_cookie_consent) wordt direct toegepast.
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied', wait_for_update: 500 });
  try {
    const c = JSON.parse(localStorage.getItem('sh_cookie_consent') || 'null');
    if (c && Date.now() < c.expires) gtag('consent', 'update', { analytics_storage: c.analytics ? 'granted' : 'denied' });
  } catch (e) {}
</script>
{gtmId && (
  <script is:inline define:vars={{ gtmId }}>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);
  </script>
)}
</head>
<body>
<noscript><style>[data-reveal],[data-reveal-onload]{opacity:1!important;transform:none!important;animation:none!important}</style></noscript>
<slot />
<CookieBanner />

<div class="form-modal-overlay" id="form-modal-overlay" style="display: none;">
  <div class="form-modal" role="status">
    <button type="button" class="form-modal__close" id="form-modal-close" aria-label="Sluiten">&times;</button>
    <p>Bedankt voor je bericht, ik neem zo snel mogelijk contact met je op.</p>
  </div>
</div>
<script>
  import '../scripts/track.ts';

  if (new URLSearchParams(window.location.search).get('verzonden')) {
    // Geen formulierdata in het event; GTM verstuurt het alleen met analytics-toestemming.
    (window as unknown as { dataLayer: object[] }).dataLayer.push({ event: 'generate_lead', form_id: 'contact', site_language: document.documentElement.lang });
    const overlay = document.getElementById('form-modal-overlay');
    if (overlay) overlay.style.display = 'flex';
    document.getElementById('form-modal-close')?.addEventListener('click', () => {
      if (overlay) overlay.style.display = 'none';
    });
    setTimeout(() => {
      window.location.href = '/';
    }, 3500);
  }
</script>
</body>
</html>
