          <p> P.C. Boutensstraat 128</p>
          <p>1822 KK Alkmaar</p>
          <p>Kvk: 95270639</p>
        </address>
        <div class="contact__methods">
          <a href="mailto:info@semhoutenbos.nl" class="contact__method">info@semhoutenbos.nl</a>
          <a href="mailto:info@balloon-magic.nl" class="contact__method">info@balloon-magic.nl</a>
          <a href="tel:+31622471896" class="contact__method">Tel: +31 6 22 47 18 96</a>
          <a href="https://wa.me/31622471896" class="contact__method" target="_blank" rel="noopener noreferrer">Whatsapp: +31 6 22 47 18 96</a>
          <div class="contact__socials">
