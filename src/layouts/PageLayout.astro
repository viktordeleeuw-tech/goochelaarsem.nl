---
import Base from './Base.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/components/_page-layout.scss';

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<Base>
  <Navigation />
  <main>
    <slot />
  </main>
  <section id="boeken" class="contact">
  <div class="container contact__inner">
    <div data-reveal="left">
      <h2 class="contact__title">Een optreden waar nog lang over wordt nagepraat</h2>
      <p class="contact__subtitle">Vertel wat u organiseert en ontdek welke act het beste past bij uw evenement, feest of gezelschap.</p>
      <div class="contact__images"><img src="/images/home-oversem-1.webp" alt="Sem performance" /><img src="/images/hero-goochelaarsem-overlay-2.webp" alt="Sem performance" /><img src="/images/home-oversem-2.webp" alt="Sem performance" /></div>
      <div class="contact__trust"><span>✓ Geen verplichtingen</span><span>★ Onlangs geboekt in Alkmaar</span></div>
    </div>
    <form class="contact__form" data-reveal="right">
      <select class="contact__form-select" required>
        <option value="">Welke show kies je?</option>
        <option value="Table Magic">Table Magic</option>
        <option value="Kindershows">Kindershows</option>
        <option value="BalloonMagic">BalloonMagic</option>
        <option value="Circus Show">Centrale act</option>
      </select>
      <select class="contact__form-select" required>
        <option value="">Wat organiseer je?</option>
        <option value="Bruiloft">Bruiloft</option>
        <option value="Bedrijfsfeest">Bedrijfsfeest</option>
        <option value="Kinderfeest">Kinderfeest</option>
        <option value="Circus / Festival">Circus / Festival</option>
        <option value="Ander evenement">Ander evenement</option>
      </select>
      <input type="text" placeholder="Naam" required class="contact__form-input" />
      <input type="email" placeholder="Je e-mailadres" required class="contact__form-input" />
      <div class="contact__form-row">
        <input type="text" placeholder="Datum" class="contact__form-input" />
        <input type="number" min="1" placeholder="Aantal gasten" class="contact__form-input" />
      </div>
      <button type="submit" class="cta-primary contact__form-submit">Check beschikbaarheid</button>
      <!-- <div class="contact__form-note contact__form-note--small">Gemiddeld 4.9 ★ uit 200+ shows</div> -->
    </form>
  </div>
</section>
  <footer class="footer">
    <div class="container footer__inner">
      <div>
        <p class="footer__subtitle">© 2026 GoochelaarSem.nl. Alle rechten voorbehouden.</p>
      </div>
      <div class="footer__right">
        <p class="footer__text">Powered by: <a href="https://lioncraft.nl" target="_blank" rel="noopener noreferrer">
      LionCraft Creative Studio</a></p>
      </div>
    </div>
  </footer>
</Base>

<script>
  const items = document.querySelectorAll('[data-reveal]');
  if (!items.length) {
    // no-op
  } else if (!('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('is-visible'));
  } else {
    items.forEach((el) => el.classList.add('reveal-pending'));

    const isInInitialViewport = (el) => {
      const r = el.getBoundingClientRect();
      return r.top < window.innerHeight && r.bottom > 0;
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -10% 0px' });

    // IntersectionObserver's *first* callback for elements already in view on
    // load fires on its own unpredictable schedule (sometimes fast, sometimes
    // only after the next scroll) — too unreliable for the hero's entrance.
    // So: reveal already-visible elements ourselves right away, and let the
    // observer handle only the elements that still need to scroll into view.
    requestAnimationFrame(() => {
      items.forEach((el) => {
        if (isInInitialViewport(el)) {
          requestAnimationFrame(() => el.classList.add('is-visible'));
        } else {
          observer.observe(el);
        }
      });
    });
  }
</script>
