</Base>

<script>
  const items = document.querySelectorAll('[data-reveal]');
  if (!items.length) {
    // no-op
  } else if (!('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('is-visible'));
  } else {
    items.forEach((el) => el.classList.add('reveal-pending'));

    const isInInitialViewport = (el) => {
      const r = el.getBoundingClientRect();
      return r.top < window.innerHeight && r.bottom > 0;
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -10% 0px' });

    // IntersectionObserver's *first* callback for elements already in view on
    // load fires on its own unpredictable schedule (sometimes fast, sometimes
    // only after the next scroll) — too unreliable for the hero's entrance.
    // So: reveal already-visible elements ourselves right away, and let the
    // observer handle only the elements that still need to scroll into view.
    requestAnimationFrame(() => {
      items.forEach((el) => {
        if (isInInitialViewport(el)) {
          requestAnimationFrame(() => el.classList.add('is-visible'));
        } else {
          observer.observe(el);
        }
      });
    });
  }
</script>
