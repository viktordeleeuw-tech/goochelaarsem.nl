---
import PageLayout from '../layouts/PageLayout.astro';
import '../styles/components/_pages.scss';
---

<PageLayout title="Contact">
  <section class="container contact-hero">
    <div class="contact-hero__inner" data-reveal-onload="up">
      <h1 class="contact-hero__title">Neem contact met me op</h1>
      <p class="contact-hero__subtitle">Vertel wat je organiseert en ontdek welke act het beste past bij jouw evenement.</p>

      <form class="contact__form">
        <div class="contact__form-group">
          <label class="contact__form-label">Welke show kies je?</label>
          <select class="contact__form-select" required>
            <option value="">Selecteer een optie</option>
            <option value="Table Magic">Table Magic</option>
            <option value="Kindershows">Kindershows</option>
            <option value="BalloonMagic">BalloonMagic</option>
            <option value="Circus Show">Circus Show</option>
          </select>
        </div>

        <div class="contact__form-group">
          <label class="contact__form-label">Wat organiseer je?</label>
          <select class="contact__form-select" required>
            <option value="">Selecteer een optie</option>
            <option value="Bruiloft">Bruiloft</option>
            <option value="Bedrijfsfeest">Bedrijfsfeest</option>
            <option value="Kinderfeest">Kinderfeest</option>
            <option value="Circus / Festival">Circus / Festival</option>
            <option value="Ander evenement">Ander evenement</option>
          </select>
        </div>

        <div class="contact__form-group">
          <label class="contact__form-label">Naam</label>
          <input type="text" placeholder="Volledige naam" required class="contact__form-input" />
        </div>

        <div class="contact__form-group">
          <label class="contact__form-label">E-mailadres</label>
          <input type="email" placeholder="jij@voorbeeld.nl" required class="contact__form-input" />
        </div>

        <div class="contact__form-row">
          <div class="contact__form-group">
            <label class="contact__form-label">Datum</label>
            <input type="text" placeholder="bijv. 15 juni 2025" class="contact__form-input" />
          </div>
          <div class="contact__form-group">
            <label class="contact__form-label">Aantal gasten</label>
            <input type="number" min="1" placeholder="bijv. 50" class="contact__form-input" />
          </div>
        </div>

        <button type="submit" class="cta-primary contact__form-submit">Check beschikbaarheid</button>
        
      </form>
    </div>
  </section>

  <section class="container contact-methods section">
    <h2 class="contact-methods__title" data-reveal="up">Andere manieren om contact op te nemen</h2>

    <div class="contact-methods__grid">
      <div class="contact-methods__item" data-reveal="up">
        <svg class="contact-methods__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <h3 class="contact-methods__heading">E-mail</h3>
        <a href="mailto:info@semhoutenbos.nl" class="contact-methods__link">info@semhoutenbos.nl</a>

      </div>

       <div class="contact-methods__item" data-reveal="up">
        <svg class="contact-methods__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <h3 class="contact-methods__heading">E-mail</h3>
        <a href="mailto:info@balloon-magic.nl" class="contact-methods__link">info@balloon-magic.nl</a>
      </div>

      <div class="contact-methods__item" data-reveal="up">
        <svg class="contact-methods__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <h3 class="contact-methods__heading">Telefoon</h3>
        <a href="tel:+31622471896" class="contact-methods__link">+31 6 22 47 18 96</a>
      </div>

      <div class="contact-methods__item" data-reveal="up">
        <svg class="contact-methods__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <h3 class="contact-methods__heading">WhatsApp</h3>
        <a href="https://wa.me/31622471896" class="contact-methods__link" target="_blank" rel="noopener noreferrer">+31 6 22 47 18 96</a>
      </div>


      <div class="contact-methods__item" data-reveal="up">
        
        <div class="contact-methods__socials">
          <a href="https://www.instagram.com/goochelaar_sem/" class="contact-methods__social" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="https://www.facebook.com/profile.php?id=100078664136443" class="contact-methods__social" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg viewBox="-2.7 -2.7 21.3 21.3" fill="currentColor" aria-hidden="true"><path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z"/></svg>
          </a>
        </div>

        <h3 class="contact-methods__heading">Social media</h3>
      </div>
    </div>
  </section>

  <section class="container contact-cta section" data-reveal="up">
    <h2 class="contact-cta__title">Klaar voor magie?</h2>
    <p class="contact-cta__text">Of je nu een intieme diner nodig hebt met Table Magic of een volledige podium show—Sem zorgt voor entertainment dat je gasten nooit zullen vergeten.</p>
  </section>
</PageLayout>
