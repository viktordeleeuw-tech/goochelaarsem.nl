---
import PageLayout from '../layouts/PageLayout.astro';
import '../styles/components/_pages.scss';

const reviews = [
  { text: "Sem is een gedreven en professionele artiest. Met zijn table magic weet hij de gasten van de eerste tot de laatste minuut te verwonderen. Een absolute aanrader voor ieder evenement!", author: "Alex Sijm" },
  { text: "Sem kwam op de receptie van de bruiloft om kinderen én andere gasten te vermaken. Wat een fantastische connectie weet hij met zijn publiek te maken. Zijn ballonkunsten zijn oprecht magisch, de kinderen kregen niet alleen een ballonfiguur, ze kregen er een hele show vol grapjes en trucjes bij!", author: "Esmee Frederiks" },
  { text: "Leuke ervaring voor de kids en de volwassenen. Doet het heel leuk en kan het publiek goed vermaken met zijn trucs. Absoluut een aanrader.", author: "Jordy Clasie" },
  { text: "Sem heeft recent het feest van mijn dochter heel leuk en bijzonder gemaakt. Kinderen hebben genoten en volwassenen ook. Bedankt Sem!", author: "Aleksandra Rakovac" },
  { text: "Bijzondere opluistering van ons 35 jaar jubileum. Tijdens de bbq heeft Sem zeer vermakelijke magische trucs getoond met veel humor. Zeer professionele instelling en uitvoering. Topper is het.", author: "Delta Duikteam" },
  { text: "Op Hemelvaartsdag organiseerden wij een kamp voor de kids van 8 tot 13. Wat deed Sem het leuk! Maakte een mooie connectie met de kinderen, grapjes en trucs waar je mond van open valt. Echt als we nog eens een goochelaar nodig hebben weet ik je te vinden!", author: "S.V. Vrone" },
  { text: "Sem trad twee weken geleden op tijdens onze jaarlijkse avond voor vrijwilligers van onze voetbalvereniging. De verbaasde blikken na een truc, het uitbundige gelach en een zeer verdiend applaus zeiden alles over het succesvolle optreden van Sem!", author: "Voetbalvereniging Opperdoes" },
  { text: "We hadden Sem geboekt met het tafelgoochelen! Het was super goed en ik snapte er niks van. Bedankt Sem!", author: "Milan" },
  { text: "Afgelopen zondag hadden wij Sem geboekt. Hij deed tafelgoochelen. Wat was het goed! Hij had zelfs nog een horloge van iemand weten af te pakken. Bedankt Sem!", author: "Leo" },
  { text: "Sem heeft zijn Centrale show van 15 minuten gedaan! En tafelgoochelen deed hij daarbij! Het was echt geweldig goede trucs en veel humor! Volgend jaar boeken we je zeker weer!", author: "Jan" },
  { text: "Sem heeft ons verbluft met zijn kunnen op de 10e versie van Franky's Kinderdag te Hengelo. Wij hebben specifiek gekozen voor een jeugdige goochelaar wat perfect paste op dit kinderevent.", author: "Edwin" },
  { text: "Keer op keer blijft ie me verbazen! Ga zo door!", author: "Dano" },
  { text: "Sem liet ons verbazen met zijn act. Het was een hele leuke avond. En we snappen nog steeds niet hoe hij die kaart liet veranderen! Volgend jaar boeken we hem zeker weer!", author: "Koen" },
  { text: "Zeer leuke goochelshow voor volwassenen en kinderen.", author: "Luna" },
  { text: "We hadden op 18 juni een geweldige avond! Zijn truc met het kaartspel dat omhoog kwam was bizar! Sem zijn tafelgoochelshow is geweldig!", author: "Jan" },
  { text: "Sem is een erg fijne man die sterk is in wat hij doet. Hij heeft de hele familie vermaakt met zijn leuke trucjes.", author: "Jari" },
];

const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'EntertainmentBusiness',
  name: 'Sem Houtenbos',
  review: reviews.map((r) => ({
    '@type': 'Review',
    reviewBody: r.text,
    author: { '@type': 'Person', name: r.author },
  })),
};
---

<PageLayout
  title="Reviews & Ervaringen | Sem Houtenbos"
  description="Lees wat gasten zeggen over de shows van Sem Houtenbos: goochelaar, entertainer en ballonkunstenaar voor evenementen door heel Nederland."
>
  <section class="container reviews-hero section">
    <h1 class="reviews-hero__title" data-reveal-onload="up">Wat zeggen onze gasten?</h1>
    <p class="reviews-hero__subtitle" data-reveal-onload="up" style="--reveal-delay: 120ms">Meer dan 50 shows, tientallen onvergetelijke momenten. Lees wat onze gasten zeggen.</p>

    <div class="testimonials__grid">
      {reviews.map((r) => (
        <div class="testimonials__card" data-reveal="scale">
          <div class="quote-mark">"</div>
          <p>{r.text}</p>
          <div class="author">— {r.author}</div>
        </div>
      ))}
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />
</PageLayout>
