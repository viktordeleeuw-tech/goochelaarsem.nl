---
import PageLayout from '../layouts/PageLayout.astro';
import '../styles/components/_pages.scss';
---

<PageLayout title="Ballon Magic">
  <section class="container show-hero section">
    <div>
      <h1 class="hero__title">Ballon Magic</h1>
      <p class="hero__sub">Wat nou als je van een stukje opblaasrubber een Donald Duck maakt? Balloncreaties die verder gaan dan je ooit voor mogelijk hield.</p>
      <a href="#boeken" class="cta-primary">Boek Ballon Magic</a>
    </div>
    <div class="hero__collage">
      <img class="main" src="/images/sem-3.jpeg" alt="Ballonkunst" />
    </div>
  </section>

  <section class="container show-section section">
    <h2 class="show-section__title">Creaties die verbaasd doen staan</h2>
    <div class="show-section__grid">
      <div class="show-section__item">
        <h3>Custom Creaties</h3>
        <p>Van dieren tot fantasiefiguren—allemaal ter plekke gemaakt.</p>
      </div>
      <div class="show-section__item">
        <h3>Gast-Interactie</h3>
        <p>Kinderen en volwassenen kunnen zelf iets kiezen.</p>
      </div>
      <div class="show-section__item">
        <h3>Visuaal Spektakel</h3>
        <p>Perfect voor bruiloften, feesten en festivals.</p>
      </div>
    </div>
  </section>

  <section id="boeken" class="contact">
    <div class="container contact__inner">
      <div>
        <h2 class="contact__title">Ballonkunst op je evenement</h2>
        <p class="contact__subtitle">Een unieke activiteit die al je gasten zal vermaken.</p>
      </div>
      <form class="contact__form">
        <input type="text" placeholder="Je naam" required class="contact__form-input" />
        <input type="email" placeholder="Je e-mailadres" required class="contact__form-input" />
        <input type="text" placeholder="Type evenement en aantal gasten" class="contact__form-input" />
        <button type="submit" class="cta-primary contact__form-submit">Vraag een offerte aan</button>
      </form>
    </div>
  </section>
</PageLayout>
